#!/usr/bin/env python3
"""Re-enable the internal laptop panel when no external output is active.

DMS can disable eDP-1 at runtime (`niri msg output eDP-1 off`), but niri never
re-applies that when the external monitor is unplugged — so the internal panel
stays dark. This watches DRM udev hotplug events (the same signal GNOME/KDE use)
and reconciles the internal panel to follow the dock: off while an external
output is live, back on when the last external is unplugged.
"""

import glob
import json
import os
import subprocess
import sys
import time

DEBOUNCE_S = 1.0

# Scale to pin on the internal panel when undocked (DMS's "Unplugged" profile
# uses 2 — i.e. 200%). Set to None to leave niri's auto-scale alone.
INTERNAL_SCALE = 2.0


def log(msg: str) -> None:
    print(msg, flush=True)


def niri_socket() -> str | None:
    """Prefer the live env var; fall back to the newest socket on disk so we
    survive a niri restart that changed the socket's pid suffix."""
    sock = os.environ.get("NIRI_SOCKET")
    if sock and os.path.exists(sock):
        return sock
    uid = os.getuid()
    socks = sorted(
        glob.glob(f"/run/user/{uid}/niri.wayland-*.sock"),
        key=os.path.getmtime,
        reverse=True,
    )
    return socks[0] if socks else None


def niri(*args: str) -> subprocess.CompletedProcess:
    env = dict(os.environ)
    sock = niri_socket()
    if sock:
        env["NIRI_SOCKET"] = sock
    return subprocess.run(
        ["niri", "msg", *args],
        capture_output=True,
        text=True,
        env=env,
    )


def run_output(name: str, *args: str) -> None:
    r = niri("output", name, *args)
    if r.returncode != 0:
        log(f"`output {name} {' '.join(args)}` failed: {r.stderr.strip()}")


def is_internal(name: str) -> bool:
    return name.startswith("eDP") or name.startswith("LVDS") or name.startswith("DSI")


def reconcile() -> None:
    proc = niri("--json", "outputs")
    if proc.returncode != 0:
        log(f"outputs query failed: {proc.stderr.strip()}")
        return
    try:
        outputs = json.loads(proc.stdout)
    except json.JSONDecodeError:
        return

    # An output is "active" when niri has given it a logical position/size.
    external_active = any(
        not is_internal(name) and out.get("logical")
        for name, out in outputs.items()
    )

    # Policy: dock follows the external. Internal panel off while an external
    # output is live, back on (at INTERNAL_SCALE) when the last one is unplugged.
    for name, out in outputs.items():
        if not is_internal(name):
            continue
        logical = out.get("logical")
        currently_on = bool(logical)

        if external_active:
            if currently_on:
                log(f"external active — turning {name} off")
                run_output(name, "off")
            continue

        # Undocked: ensure the panel is on and at the wanted scale.
        if not currently_on:
            log(f"external gone — turning {name} on")
            run_output(name, "on")
        if INTERNAL_SCALE is not None and (logical or {}).get("scale") != INTERNAL_SCALE:
            log(f"pinning {name} scale to {INTERNAL_SCALE:g}")
            run_output(name, "scale", str(INTERNAL_SCALE))


def main() -> int:
    log("niri-auto-display: watching DRM hotplug events")
    reconcile()  # fix up state at startup too

    mon = subprocess.Popen(
        ["udevadm", "monitor", "--udev", "--subsystem-match=drm"],
        stdout=subprocess.PIPE,
        text=True,
    )
    assert mon.stdout is not None
    for _line in mon.stdout:
        # Coalesce the burst of events a single plug/unplug produces, and give
        # niri a beat to settle its output list before we query it.
        time.sleep(DEBOUNCE_S)
        # Drain anything that piled up during the sleep is unnecessary —
        # reconcile is idempotent, so an extra pass costs nothing.
        reconcile()
    return mon.wait()


if __name__ == "__main__":
    sys.exit(main())
